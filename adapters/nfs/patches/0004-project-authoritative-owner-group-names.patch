+static fattr_xdr_result encode_projected_identity(
+	XDR *xdr, struct xdr_attrs_args *args, bool group)
+{
+	struct gsh_buffdesc owner_name = { 0 };
+	struct gsh_buffdesc group_name = { 0 };
+	struct gsh_buffdesc *selected = group ? &group_name : &owner_name;
+	fsal_status_t status;
+	char *name;
+	uint32_t length;
+
+	if (args->obj == NULL)
+		return FATTR_XDR_NOOP;
+	status = args->obj->obj_ops->get_owner_group_names(
+		args->obj, args->attrs->owner, args->attrs->group,
+		&owner_name, &group_name);
+	if (status.major == ERR_FSAL_NOTSUPP)
+		return FATTR_XDR_NOOP;
+	if (FSAL_IS_ERROR(status) || selected->addr == NULL ||
+	    selected->len == 0 || selected->len > 1024)
+		return FATTR_XDR_FAILED;
+	name = selected->addr;
+	length = (uint32_t)selected->len;
+	return inline_xdr_bytes(xdr, &name, &length, 1024) ?
+		FATTR_XDR_SUCCESS : FATTR_XDR_FAILED;
+}
+
 static fattr_xdr_result encode_owner(XDR *xdr, struct xdr_attrs_args *args)
 {
+	fattr_xdr_result result = encode_projected_identity(xdr, args, false);
+
+	if (result != FATTR_XDR_NOOP)
+		return result;
 	return xdr_encode_nfs4_owner(xdr, args->attrs->owner) ?
 		       FATTR_XDR_SUCCESS :
 		       FATTR_XDR_FAILED;
