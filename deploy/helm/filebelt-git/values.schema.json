{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "gitNamespace", "coreNamespace", "image", "config", "limits", "secrets", "storage", "service", "workload", "networkPolicy"],
  "properties": {
    "global": {"type": "object", "additionalProperties": false, "required": ["registry", "registryMirror", "runAsUser", "runAsGroup"], "properties": {"registry": {"type": "string", "minLength": 1}, "registryMirror": {"type": "string"}, "runAsUser": {"const": 10001}, "runAsGroup": {"const": 10001}}},
    "gitNamespace": {"$ref": "#/$defs/name"}, "coreNamespace": {"$ref": "#/$defs/name"},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "registryMirror", "digest", "license", "correspondingSource"], "properties": {"repository": {"const": "oxibelt/filebelt-git-adapter"}, "registryMirror": {"type": "string"}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "license": {"const": "GPL-2.0-only"}, "correspondingSource": {"type": "string", "minLength": 1}}},
    "config": {"$ref": "#/$defs/config"},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maxConcurrentPrivateRequests", "maxConcurrentGitProcesses"], "properties": {"maxConcurrentPrivateRequests": {"type": "integer", "minimum": 1, "maximum": 64}, "maxConcurrentGitProcesses": {"type": "integer", "minimum": 1, "maximum": 16}}},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["serverTls"], "properties": {"serverTls": {"$ref": "#/$defs/tls"}}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["existingClaim", "mountPath"], "properties": {"existingClaim": {"$ref": "#/$defs/name"}, "mountPath": {"const": "/var/lib/filebelt/git"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"const": 8092}}},
    "workload": {"type": "object", "additionalProperties": false, "required": ["replicas", "terminationGracePeriodSeconds", "resources"], "properties": {"replicas": {"const": 1}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 600}, "resources": {"type": "object"}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["coordinatorIngress"], "properties": {"coordinatorIngress": {"type": "object", "additionalProperties": false, "required": ["from"], "properties": {"from": {"type": "array", "minItems": 1}}}}}
  },
  "$defs": {"name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "config": {"type": "object", "additionalProperties": false, "required": ["existingConfigMap", "key", "generation"], "properties": {"existingConfigMap": {"$ref": "#/$defs/name"}, "key": {"type": "string", "minLength": 1}, "generation": {"type": "string", "minLength": 1}}}, "tls": {"type": "object", "additionalProperties": false, "required": ["name", "certificateKey", "privateKeyKey", "caKey", "generation"], "properties": {"name": {"$ref": "#/$defs/name"}, "certificateKey": {"type": "string", "minLength": 1}, "privateKeyKey": {"type": "string", "minLength": 1}, "caKey": {"type": "string", "minLength": 1}, "generation": {"type": "string", "minLength": 1}}}}
}
