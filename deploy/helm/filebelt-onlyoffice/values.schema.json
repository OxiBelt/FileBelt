{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "FileBelt ONLYOFFICE adapter delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "integrationNamespace", "coreNamespace", "image", "providerConfig", "secrets", "workload", "service", "networkPolicy"],
  "properties": {
    "global": {"$ref": "#/definitions/global"},
    "integrationNamespace": {"$ref": "#/definitions/dnsLabel"},
    "coreNamespace": {"$ref": "#/definitions/dnsLabel"},
    "image": {"$ref": "#/definitions/adapterImage"},
    "providerConfig": {"type": "object", "additionalProperties": false, "required": ["existingConfigMap", "key", "file", "generation"], "properties": {"existingConfigMap": {"$ref": "#/definitions/dnsLabel"}, "key": {"$ref": "#/definitions/key"}, "file": {"const": "/etc/filebelt-onlyoffice/provider/provider.toml"}, "generation": {"$ref": "#/definitions/generation"}}},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["browserJwt", "outboxJwt", "serverTls", "coreClientTls", "ioClientTls", "egressClientTls", "privateEgressClientTls"], "properties": {"browserJwt": {"$ref": "#/definitions/singleKeySecret"}, "outboxJwt": {"$ref": "#/definitions/rotatingJwtSecret"}, "serverTls": {"$ref": "#/definitions/tlsSecret"}, "coreClientTls": {"$ref": "#/definitions/tlsSecret"}, "ioClientTls": {"$ref": "#/definitions/tlsSecret"}, "egressClientTls": {"$ref": "#/definitions/tlsSecret"}, "privateEgressClientTls": {"$ref": "#/definitions/tlsSecret"}}},
    "workload": {"$ref": "#/definitions/workload"},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["oxibeltIngress", "dns", "core", "io", "egressGateway", "privateEgress", "otlp"], "properties": {"oxibeltIngress": {"$ref": "#/definitions/fromList"}, "dns": {"$ref": "#/definitions/toList"}, "core": {"$ref": "#/definitions/destination"}, "io": {"$ref": "#/definitions/destination"}, "egressGateway": {"$ref": "#/definitions/destination"}, "privateEgress": {"$ref": "#/definitions/optionalDestination"}, "otlp": {"$ref": "#/definitions/optionalDestination"}}}
  },
  "definitions": {
    "global": {"type": "object", "additionalProperties": false, "required": ["registry", "registryMirror", "runAsUser", "runAsGroup"], "properties": {"registry": {"$ref": "#/definitions/registry"}, "registryMirror": {"$ref": "#/definitions/optionalRegistry"}, "runAsUser": {"const": 10001}, "runAsGroup": {"const": 10001}}},
    "registry": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?$"},
    "optionalRegistry": {"type": "string", "pattern": "^(?:|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?)$"},
    "dnsLabel": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "adapterImage": {"type": "object", "additionalProperties": false, "required": ["repository", "registryMirror", "digest", "license", "correspondingSource", "correspondingSourceSha256", "qualification"], "properties": {"repository": {"const": "oxibelt/filebelt-onlyoffice-adapter"}, "registryMirror": {"$ref": "#/definitions/optionalRegistry"}, "digest": {"$ref": "#/definitions/digest"}, "license": {"const": "AGPL-3.0-only"}, "correspondingSource": {"const": "https://github.com/OxiBelt/FileBelt/releases/download/0.1.0/filebelt-onlyoffice-adapter-source-0.1.0.tar.gz"}, "correspondingSourceSha256": {"pattern": "^[0-9a-f]{64}$"}, "qualification": {"enum": ["blocked", "qualified"]}}},
    "generation": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "singleKeySecret": {"type": "object", "additionalProperties": false, "required": ["name", "key", "generation"], "properties": {"name": {"$ref": "#/definitions/dnsLabel"}, "key": {"$ref": "#/definitions/key"}, "generation": {"$ref": "#/definitions/generation"}}},
    "rotatingJwtSecret": {"type": "object", "additionalProperties": false, "required": ["name", "currentKey", "retiringKey", "generation"], "properties": {"name": {"$ref": "#/definitions/dnsLabel"}, "currentKey": {"$ref": "#/definitions/key"}, "retiringKey": {"$ref": "#/definitions/optionalKey"}, "generation": {"$ref": "#/definitions/generation"}}},
    "optionalKey": {"type": "string", "maxLength": 253, "pattern": "^(?:|[A-Za-z0-9._-]+)$"},
    "tlsSecret": {"type": "object", "additionalProperties": false, "required": ["name", "certificateKey", "privateKeyKey", "caKey", "generation"], "properties": {"name": {"$ref": "#/definitions/dnsLabel"}, "certificateKey": {"$ref": "#/definitions/key"}, "privateKeyKey": {"$ref": "#/definitions/key"}, "caKey": {"$ref": "#/definitions/key"}, "generation": {"$ref": "#/definitions/generation"}}},
    "quantity": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:m|Ki|Mi|Gi|Ti)?$"},
    "resourceValues": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory", "ephemeral-storage"], "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}, "ephemeral-storage": {"$ref": "#/definitions/quantity"}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"$ref": "#/definitions/resourceValues"}, "limits": {"$ref": "#/definitions/resourceValues"}}},
    "workload": {"type": "object", "additionalProperties": false, "required": ["replicas", "terminationGracePeriodSeconds", "resources"], "properties": {"replicas": {"const": 2}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30, "maximum": 600}, "resources": {"$ref": "#/definitions/resources"}}},
    "labels": {"type": "object", "propertyNames": {"type": "string", "maxLength": 253}, "additionalProperties": {"type": "string", "maxLength": 63}},
    "selectorLabels": {"type": "object", "minProperties": 1, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 253}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 63}},
    "selector": {"type": "object", "additionalProperties": false, "required": ["matchLabels"], "properties": {"matchLabels": {"$ref": "#/definitions/selectorLabels"}}},
    "peer": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"namespaceSelector": {"$ref": "#/definitions/selector"}, "podSelector": {"$ref": "#/definitions/selector"}, "ipBlock": {"type": "object", "additionalProperties": false, "required": ["cidr"], "properties": {"cidr": {"type": "string", "minLength": 3, "maxLength": 49}, "except": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 49}}}}}, "oneOf": [{"required": ["ipBlock"]}, {"required": ["namespaceSelector"], "not": {"required": ["podSelector"]}}, {"required": ["podSelector"], "not": {"required": ["namespaceSelector"]}}, {"required": ["namespaceSelector", "podSelector"]}]},
    "peers": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/definitions/peer"}},
    "fromList": {"type": "object", "additionalProperties": false, "required": ["from"], "properties": {"from": {"$ref": "#/definitions/peers"}}},
    "toList": {"type": "object", "additionalProperties": false, "required": ["to"], "properties": {"to": {"$ref": "#/definitions/peers"}}},
    "destination": {"type": "object", "additionalProperties": false, "required": ["port", "to"], "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}, "to": {"$ref": "#/definitions/peers"}}},
    "optionalDestination": {"type": "object", "additionalProperties": false, "required": ["enabled", "port", "to"], "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "to": {"type": "array", "maxItems": 16, "items": {"$ref": "#/definitions/peer"}}}, "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"to": {"minItems": 1}}}}]}
  }
}
