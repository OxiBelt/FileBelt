{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FileBelt curated MCP runner catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]{1,20}(?:m|Ki|Mi|Gi|Ti)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "image", "source", "license", "command", "architectures", "egressProfile", "signature", "resources"],
      "properties": {
        "name": {"$ref": "#/$defs/dnsLabel"},
        "repository": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?:ghcr\\.io|docker\\.io)/[a-z0-9][a-z0-9._/-]*[a-z0-9]$"
        },
        "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "command": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 4096},
          "default": []
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64", "riscv64"]}
        },
        "egressProfile": {"$ref": "#/$defs/dnsLabel"},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundleFile", "identity", "issuer"],
          "properties": {
            "bundleFile": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/].*$", "not": {"pattern": "(?:^|/)\\.\\.(?:/|$)"}},
            "identity": {"type": "string", "minLength": 1, "maxLength": 2048},
            "issuer": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuRequest", "cpuLimit", "memoryRequest", "memoryLimit", "ephemeralStorageLimit"],
          "properties": {
            "cpuRequest": {"$ref": "#/$defs/quantity"},
            "cpuLimit": {"$ref": "#/$defs/quantity"},
            "memoryRequest": {"$ref": "#/$defs/quantity"},
            "memoryLimit": {"$ref": "#/$defs/quantity"},
            "ephemeralStorageLimit": {"$ref": "#/$defs/quantity"}
          }
        }
      }
    }
  }
}
