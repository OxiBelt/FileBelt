{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "FileBelt Phase 9 Kubernetes deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "images", "deployment", "configuration", "workloads", "storage", "secrets", "mcp", "collaboration", "documents", "revisions", "mounts", "networkPolicy", "monitoring", "operation"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "registryMirror", "platformIntent", "runAsUser", "runAsGroup"],
      "properties": {
        "registry": {"$ref": "#/definitions/registry"},
        "registryMirror": {"$ref": "#/definitions/optionalRegistry"},
        "platformIntent": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["linux/amd64", "linux/arm64", "linux/riscv64"]},
          "allOf": [
            {"contains": {"const": "linux/amd64"}},
            {"contains": {"const": "linux/arm64"}},
            {"contains": {"const": "linux/riscv64"}}
          ]
        },
        "runAsUser": {"const": 10001},
        "runAsGroup": {"const": 10001}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["filebelt-api", "filebelt-worker-io", "filebelt-worker-maintenance", "filebelt-tools", "filebelt-web", "filebelt-collaboration", "filebelt-mcp-broker", "filebelt-controller", "filebelt-mcp-runner", "filebelt-vfs", "filebelt-headscale-sync", "filebelt-document", "filebelt-revision", "filebelt-smb-gateway", "filebelt-ftp-ftps-gateway", "filebelt-nfs-gateway", "filebelt-nfs-relay", "tailscaled"],
      "properties": {
        "filebelt-api": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-api"}}}]},
        "filebelt-worker-io": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-worker-io"}}}]},
        "filebelt-worker-maintenance": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-worker-maintenance"}}}]},
        "filebelt-tools": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-tools"}}}]},
        "filebelt-web": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-web"}}}]},
        "filebelt-collaboration": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-collaboration"}}}]},
        "filebelt-mcp-broker": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-mcp-broker"}}}]},
        "filebelt-controller": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-controller"}}}]},
        "filebelt-mcp-runner": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-mcp-runner"}}}]},
        "filebelt-vfs": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-vfs"}}}]},
        "filebelt-headscale-sync": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-headscale-sync"}}}]},
        "filebelt-document": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-document"}}}]},
        "filebelt-revision": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-revision"}}}]},
        "filebelt-smb-gateway": {"allOf": [{"$ref": "#/definitions/adapterImage"}, {"properties": {"repository": {"const": "oxibelt/filebelt-smb-gateway"}, "license": {"const": "GPL-3.0-or-later"}}}]},
        "filebelt-ftp-ftps-gateway": {"allOf": [{"$ref": "#/definitions/adapterImage"}, {"properties": {"repository": {"const": "oxibelt/filebelt-ftp-ftps-gateway"}, "license": {"const": "GPL-3.0-or-later"}}}]},
        "filebelt-nfs-gateway": {"allOf": [{"$ref": "#/definitions/adapterImage"}, {"properties": {"repository": {"const": "oxibelt/filebelt-nfs-gateway"}, "license": {"const": "LGPL-3.0-or-later"}}}]},
        "filebelt-nfs-relay": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "oxibelt/filebelt-nfs-relay"}}}]},
        "tailscaled": {"allOf": [{"$ref": "#/definitions/image"}, {"properties": {"repository": {"const": "tailscale/tailscale"}}}]}
      }
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["quiesced", "revisionHistoryLimit", "minReadySeconds"],
      "properties": {
        "quiesced": {"type": "boolean"},
        "revisionHistoryLimit": {"type": "integer", "minimum": 1, "maximum": 20},
        "minReadySeconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["filebelt", "oxibelt"],
      "properties": {
        "filebelt": {"type": "string", "minLength": 1, "maxLength": 131072},
        "oxibelt": {"type": "string", "minLength": 1, "maxLength": 262144}
      }
    },
    "workloads": {
      "type": "object", "additionalProperties": false,
      "required": ["web", "api", "io", "maintenance", "collaboration", "document", "revision", "mcpBroker", "controller", "operation"],
      "properties": {
        "web": {"$ref": "#/definitions/servingWorkload"},
        "api": {"$ref": "#/definitions/servingWorkload"},
        "io": {"$ref": "#/definitions/servingWorkload"},
        "maintenance": {"$ref": "#/definitions/servingWorkload"},
        "collaboration": {"$ref": "#/definitions/servingWorkload"},
        "document": {"$ref": "#/definitions/servingWorkload"},
        "revision": {"allOf": [{"$ref": "#/definitions/servingWorkload"}, {"properties": {"replicas": {"const": 1}}}]},
        "mcpBroker": {"$ref": "#/definitions/servingWorkload"},
        "controller": {"$ref": "#/definitions/servingWorkload"},
        "operation": {
          "type": "object", "additionalProperties": false,
          "required": ["resources"],
          "properties": {
            "resources": {
              "type": "object", "additionalProperties": false,
              "required": ["database", "storage"],
              "properties": {
                "database": {"$ref": "#/definitions/resources"},
                "storage": {"$ref": "#/definitions/resources"}
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["existingClaim", "mountPath"],
      "properties": {
        "existingClaim": {"$ref": "#/definitions/dnsLabel"},
        "mountPath": {"type": "string", "pattern": "^/.*$", "maxLength": 1024}
      }
    },
    "secrets": {
      "type": "object", "additionalProperties": false,
      "required": ["apiDatabase", "ioDatabase", "maintenanceDatabase", "migratorDatabase", "auditDatabase", "recoveryDatabase", "oidcClient", "oidcCa", "apiStorageCapabilityPrivateKey", "apiStorageCapabilityPublicKeyset", "apiCollaborationGrantCapabilityPrivateKey", "apiCollaborationGrantCapabilityPublicKeyset", "apiMcpDelegationCapabilityPrivateKey", "apiMcpDelegationCapabilityPublicKeyset", "collaborationStorageCapabilityPrivateKey", "collaborationStorageCapabilityPublicKeyset", "documentStorageCapabilityPrivateKey", "documentStorageCapabilityPublicKeyset", "mountStorageCapabilityPrivateKey", "mountStorageCapabilityPublicKeyset", "mediaStorageCapabilityPrivateKey", "mediaStorageCapabilityPublicKeyset", "digestKey", "publicTls", "apiServerTls", "ioServerTls", "apiClientTls", "ioClientTls", "collaborationDatabase", "collaborationServerTls", "collaborationIoClientTls", "collaborationEdgeClientTls", "mcpDatabase", "mcpVaultKeyring", "mcpBrokerServerTls", "apiMcpClientTls", "mcpGatewayClientTls", "mcpBackendClientTls", "controllerServerTls", "controllerClientTls", "runnerBrokerClientTls", "runnerGatewayClientTls", "vfsDatabase", "headscaleSyncDatabase", "mountVaultKeyring", "vfsServerTls", "vfsManagementServerTls", "vfsManagementClientTls", "vfsIoClientTls", "headscaleApiToken", "headscaleServerCa", "nfsGaneshaKeytab", "nfsBridgeVfsClientTls", "nfsHandleKeyring", "documentDatabase", "documentApiServerTls", "documentAdapterServerTls", "apiDocumentClientTls", "onlyofficeEdgeClientTls", "revisionDatabase", "revisionStorageCapabilityPrivateKey", "revisionStorageCapabilityPublicKeyset", "revisionServerTls", "apiRevisionClientTls", "revisionAdapterClientTls", "revisionIoClientTls"],
      "properties": {
        "apiDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "ioDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "maintenanceDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "migratorDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "auditDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "recoveryDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "oidcClient": {"$ref": "#/definitions/singleKeySecret"},
        "oidcCa": {"$ref": "#/definitions/singleKeySecret"},
        "apiStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "apiStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "apiCollaborationGrantCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "apiCollaborationGrantCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "apiMcpDelegationCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "apiMcpDelegationCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "collaborationStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "collaborationStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "documentStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "documentStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "mountStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "mountStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "mediaStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"},
        "mediaStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"},
        "digestKey": {"$ref": "#/definitions/singleKeySecret"},
        "publicTls": {"$ref": "#/definitions/keyPairSecret"},
        "apiServerTls": {"$ref": "#/definitions/tlsSecret"},
        "ioServerTls": {"$ref": "#/definitions/tlsSecret"},
        "apiClientTls": {"$ref": "#/definitions/tlsSecret"},
        "ioClientTls": {"$ref": "#/definitions/tlsSecret"},
        "collaborationDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "collaborationServerTls": {"$ref": "#/definitions/tlsSecret"},
        "collaborationIoClientTls": {"$ref": "#/definitions/tlsSecret"},
        "collaborationEdgeClientTls": {"$ref": "#/definitions/tlsSecret"},
        "mcpDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "mcpVaultKeyring": {"$ref": "#/definitions/singleKeySecret"},
        "mcpBrokerServerTls": {"$ref": "#/definitions/tlsSecret"},
        "apiMcpClientTls": {"$ref": "#/definitions/tlsSecret"},
        "mcpGatewayClientTls": {"$ref": "#/definitions/tlsSecret"},
        "mcpBackendClientTls": {"$ref": "#/definitions/tlsSecret"},
        "controllerServerTls": {"$ref": "#/definitions/tlsSecret"},
        "controllerClientTls": {"$ref": "#/definitions/tlsSecret"},
        "runnerBrokerClientTls": {"$ref": "#/definitions/tlsSecret"},
        "runnerGatewayClientTls": {"$ref": "#/definitions/tlsSecret"},
        "vfsDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "headscaleSyncDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "mountVaultKeyring": {"$ref": "#/definitions/singleKeySecret"},
        "vfsServerTls": {"$ref": "#/definitions/tlsSecret"},
        "vfsManagementServerTls": {"$ref": "#/definitions/tlsSecret"},
        "vfsManagementClientTls": {"$ref": "#/definitions/tlsSecret"},
        "vfsIoClientTls": {"$ref": "#/definitions/tlsSecret"},
        "headscaleApiToken": {"$ref": "#/definitions/singleKeySecret"},
        "headscaleServerCa": {"$ref": "#/definitions/singleKeySecret"},
        "nfsGaneshaKeytab": {"$ref": "#/definitions/singleKeySecret"},
        "nfsBridgeVfsClientTls": {"$ref": "#/definitions/tlsSecret"},
        "nfsHandleKeyring": {"$ref": "#/definitions/singleKeySecret"},
        "documentDatabase": {"$ref": "#/definitions/singleKeySecret"},
        "documentApiServerTls": {"$ref": "#/definitions/tlsSecret"},
        "documentAdapterServerTls": {"$ref": "#/definitions/tlsSecret"},
        "apiDocumentClientTls": {"$ref": "#/definitions/tlsSecret"},
        "onlyofficeEdgeClientTls": {"$ref": "#/definitions/tlsSecret"}
        ,"revisionDatabase": {"$ref": "#/definitions/singleKeySecret"}
        ,"revisionStorageCapabilityPrivateKey": {"$ref": "#/definitions/singleKeySecret"}
        ,"revisionStorageCapabilityPublicKeyset": {"$ref": "#/definitions/singleKeySecret"}
        ,"revisionServerTls": {"$ref": "#/definitions/tlsSecret"}
        ,"apiRevisionClientTls": {"$ref": "#/definitions/tlsSecret"}
        ,"revisionAdapterClientTls": {"$ref": "#/definitions/tlsSecret"}
        ,"revisionIoClientTls": {"$ref": "#/definitions/tlsSecret"}
      }
    },
    "mcp": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "runners", "gateway"],
      "properties": {
        "enabled": {"type": "boolean"},
        "runners": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "namespace", "catalogConfigMap", "catalogKey", "trustedRootConfigMap", "trustedRootKey", "bundlesConfigMap"],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"$ref": "#/definitions/dnsLabel"},
            "catalogConfigMap": {"$ref": "#/definitions/dnsLabel"},
            "catalogKey": {"$ref": "#/definitions/secretKey"},
            "trustedRootConfigMap": {"$ref": "#/definitions/dnsLabel"},
            "trustedRootKey": {"$ref": "#/definitions/secretKey"},
            "bundlesConfigMap": {"$ref": "#/definitions/dnsLabel"}
          }
        },
        "gateway": {
          "type": "object", "additionalProperties": false,
          "required": ["address", "serverName", "profile"],
          "properties": {
            "address": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^[A-Za-z0-9.-]+:[1-9][0-9]{0,4}$"},
            "serverName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.-]+$"},
            "profile": {"$ref": "#/definitions/dnsLabel"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"runners": {"properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"enabled": {"const": true}}}}
      ]
    },
    "collaboration": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "webtransport"],
      "properties": {
        "enabled": {"type": "boolean"},
        "webtransport": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}
      },
      "allOf": [
        {"if": {"properties": {"webtransport": {"properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"enabled": {"const": true}}}}
      ]
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "integrationNamespace", "adapterOrigin", "adapterServerName", "adapterPort", "launchAction", "providerOrigin"],
      "properties": {
        "enabled": {"type": "boolean"},
        "integrationNamespace": {"$ref": "#/definitions/dnsLabel"},
        "adapterOrigin": {"type": "string", "pattern": "^https://[a-z0-9.-]+:[1-9][0-9]{0,4}$", "maxLength": 512},
        "adapterServerName": {"type": "string", "pattern": "^[a-z0-9.-]+$", "minLength": 1, "maxLength": 253},
        "adapterPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "launchAction": {"type": "string", "pattern": "^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?/onlyoffice/launch$", "maxLength": 512},
        "providerOrigin": {"type": "string", "pattern": "^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$", "maxLength": 512}
      }
    },
    "revisions": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "gitNamespace", "adapterOrigin", "adapterServerName", "adapterPort", "activation"],
      "properties": {
        "enabled": {"type": "boolean"},
        "gitNamespace": {"$ref": "#/definitions/dnsLabel"},
        "adapterOrigin": {"type": "string", "pattern": "^https://[a-z0-9.-]+:[1-9][0-9]{0,4}$", "maxLength": 512},
        "adapterServerName": {"type": "string", "pattern": "^[a-z0-9.-]+$", "minLength": 1, "maxLength": 253},
        "adapterPort": {"const": 8092},
        "activation": {"type": "object", "additionalProperties": false, "required": ["compatibilityGate"], "properties": {"compatibilityGate": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$|^$"}}}
      }
    },
    "mounts": {
      "type": "object", "additionalProperties": false,
      "required": ["tailnet", "headscale", "vfs", "headscaleSync", "smb", "ftpFtps", "nfs"],
      "properties": {
        "tailnet": {"type": "object", "additionalProperties": false, "required": ["kernelNetworking", "address", "authKeySecret"], "properties": {"kernelNetworking": {"const": true, "description": "Direct tailnet listeners require kernel networking; userspace mode needs a separately designed proxy."}, "address": {"type": "string", "pattern": "^https://", "minLength": 9, "maxLength": 253}, "authKeySecret": {"$ref": "#/definitions/singleKeySecret"}}},
        "headscale": {"type": "object", "additionalProperties": false, "required": ["apiUrl", "oidcIssuer", "syncSeconds"], "properties": {"apiUrl": {"type": "string", "pattern": "^https://", "minLength": 9, "maxLength": 253}, "oidcIssuer": {"type": "string", "pattern": "^https://", "minLength": 9, "maxLength": 253}, "syncSeconds": {"type": "integer", "minimum": 5, "maximum": 300}}},
        "vfs": {"$ref": "#/definitions/vfsMountDeployment"},
        "headscaleSync": {"$ref": "#/definitions/mountDeployment"},
        "smb": {"$ref": "#/definitions/tailnetStatefulSet"},
        "ftpFtps": {"type": "object", "additionalProperties": false, "required": ["enabled", "previousGatewayUriSan", "tailstateClaim", "resources", "passivePorts"], "properties": {"enabled": {"type": "boolean"}, "previousGatewayUriSan": {"$ref": "#/definitions/optionalSpiffeUri"}, "tailstateClaim": {"$ref": "#/definitions/dnsLabel"}, "resources": {"$ref": "#/definitions/resources"}, "passivePorts": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "integer", "minimum": 1024, "maximum": 65535}}}},
        "nfs": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "previousGatewayUriSan", "realm", "idmapDomain", "handleKeyGeneration", "graceSeconds", "tailstateClaim", "recoveryClaim", "backendClusterIP", "terminationGracePeriodSeconds", "ganesha", "bridge", "tailscaled", "relay"],
          "properties": {
            "enabled": {"type": "boolean"},
            "previousGatewayUriSan": {"$ref": "#/definitions/optionalSpiffeUri"},
            "realm": {"type": "string", "maxLength": 255, "pattern": "^(?:|[A-Z0-9][A-Z0-9.-]*)$"},
            "idmapDomain": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?)$"},
            "handleKeyGeneration": {"type": "integer", "minimum": 1, "maximum": 4294967295},
            "graceSeconds": {"type": "integer", "minimum": 30, "maximum": 300},
            "tailstateClaim": {"$ref": "#/definitions/optionalDnsLabel"},
            "recoveryClaim": {"$ref": "#/definitions/optionalDnsLabel"},
            "backendClusterIP": {"$ref": "#/definitions/optionalIpAddress"},
            "terminationGracePeriodSeconds": {"type": "integer", "minimum": 60, "maximum": 600},
            "ganesha": {"$ref": "#/definitions/nfsProcess"},
            "bridge": {"$ref": "#/definitions/nfsProcess"},
            "tailscaled": {"type": "object", "additionalProperties": false, "required": ["resources"], "properties": {"resources": {"$ref": "#/definitions/resources"}}},
            "relay": {
              "type": "object", "additionalProperties": false,
              "required": ["maxConnections", "maxConnectionsPerSource", "connectTimeoutSeconds", "inactivityTimeoutSeconds", "drainTimeoutSeconds", "resources"],
              "properties": {
                "maxConnections": {"type": "integer", "minimum": 1, "maximum": 4096},
                "maxConnectionsPerSource": {"type": "integer", "minimum": 1, "maximum": 256},
                "connectTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
                "inactivityTimeoutSeconds": {"type": "integer", "minimum": 120, "maximum": 3600},
                "drainTimeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 300},
                "resources": {"$ref": "#/definitions/resources"}
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["publicIngress", "monitoring", "dns", "postgres", "oidcGateway", "mcpGateway", "kubernetesApi", "iggy", "otlp", "headscale", "mountIngress"],
      "properties": {
        "publicIngress": {"$ref": "#/definitions/fromList"},
        "monitoring": {"$ref": "#/definitions/fromList"},
        "dns": {
          "type": "object", "additionalProperties": false, "required": ["to"],
          "properties": {"to": {"$ref": "#/definitions/peers"}}
        },
        "postgres": {"$ref": "#/definitions/destination"},
        "oidcGateway": {"$ref": "#/definitions/destination"},
        "mcpGateway": {"$ref": "#/definitions/optionalDestination"},
        "kubernetesApi": {"$ref": "#/definitions/optionalDestination"},
        "iggy": {"$ref": "#/definitions/optionalDestination"},
        "otlp": {"$ref": "#/definitions/optionalDestination"},
        "headscale": {"$ref": "#/definitions/destination"},
        "mountIngress": {"$ref": "#/definitions/fromList"}
      }
    },
    "monitoring": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "interval", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"},
            "labels": {"$ref": "#/definitions/labels"}
          }
        },
        "prometheusRule": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "labels"],
          "properties": {"enabled": {"type": "boolean"}, "labels": {"$ref": "#/definitions/labels"}}
        }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "operationId", "tenantSlugConfirmation", "actorPrincipalId", "payloadId", "args", "checkpoint"],
      "properties": {
        "type": {"enum": ["none", "migrate", "bootstrap", "verify-grants", "keys-audit", "storage-probe", "storage-scrub-start", "storage-scrub-status", "storage-scrub-verify", "recovery-checkpoint", "recovery-verify", "audit-export", "security-descendant-shares-status", "security-descendant-shares-repair", "security-descendant-shares-verify", "security-descendant-shares-activate"]},
        "operationId": {"type": "string", "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
        "tenantSlugConfirmation": {"type": "string", "maxLength": 63, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)$"},
        "actorPrincipalId": {"type": "string", "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
        "payloadId": {"type": "string", "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"},
        "args": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}},
        "checkpoint": {
          "type": "object", "additionalProperties": false, "required": ["secretName", "key"],
          "properties": {
            "secretName": {"type": "string", "maxLength": 63, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)$"},
            "key": {"$ref": "#/definitions/secretKey"}
          }
        }
      },
