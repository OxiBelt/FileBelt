  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "min by (pod) (filebelt_ready)", "refId": "A"}],
      "title": "Role readiness",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "filebelt_oidc_metadata_age_seconds", "refId": "A"}],
      "title": "OIDC metadata age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "filebelt_storage_capacity_bytes", "refId": "A"}],
      "title": "Payload capacity",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(rate(filebelt_http_requests_total[5m]))", "refId": "A"},
        {"expr": "sum(rate(filebelt_http_failures_total[5m]))", "refId": "B"}
      ],
      "title": "Request and failure rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "increase(filebelt_maintenance_reconciliations_total[1h])", "refId": "A"},
        {"expr": "increase(filebelt_maintenance_scrub_jobs_created_total[1h])", "refId": "B"},
        {"expr": "increase(filebelt_maintenance_job_cycle_failures_total[1h])", "refId": "C"}
      ],
      "title": "Maintenance activity",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(filebelt_mcp_active_invocations)", "refId": "A"},
        {"expr": "sum(rate(filebelt_mcp_policy_denials_total[5m]))", "refId": "B"},
        {"expr": "sum(filebelt_mcp_quarantined_registrations)", "refId": "C"}
      ],
      "title": "MCP broker activity",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "filebelt_controller_leader", "refId": "A"},
        {"expr": "increase(filebelt_controller_runner_created_total[1h])", "refId": "B"},
        {"expr": "increase(filebelt_controller_reconciliation_failures_total[1h])", "refId": "C"}
      ],
      "title": "MCP runner controller",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(filebelt_revision_comparisons_active)", "refId": "A"},
        {"expr": "sum(increase(filebelt_revision_comparison_admission_rejections_total[10m]))", "refId": "B"}
      ],
      "title": "Revision comparison admission",
      "type": "timeseries"
    }
  ],
