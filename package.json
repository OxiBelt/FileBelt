{
  "name": "@filebelt/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "format": "oxfmt --write --disable-nested-config \"**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\" \"!ui/web/source/generated/openapi.ts\"",
    "format:check": "oxfmt --check --disable-nested-config \"**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\" \"!ui/web/source/generated/openapi.ts\"",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives --disable-nested-config .",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
