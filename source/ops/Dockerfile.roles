# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# SPDX-License-Identifier: Apache-2.0

ARG RUST_BUILDER_IMAGE=rust:1.97.1-trixie@sha256:b1b3c9c0d921d7fa0a6d1f9ec7e4eab87f8c8ec97644c3d791450f131dec813f
ARG RISCV64_TOOLCHAIN_IMAGE=ghcr.io/cross-rs/riscv64gc-unknown-linux-musl@sha256:60372bf6ad955bc04ac9b0689476b05955b4e90fc2030d311be687025672cc6d
ARG FILEBELT_BUILDER_STAGE=builder-native

FROM --platform=$BUILDPLATFORM ${RUST_BUILDER_IMAGE} AS builder-base

RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20260713T000000Z|' \
      -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20260713T000000Z|' \
      /etc/apt/sources.list.d/debian.sources && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      binutils=2.44-3 \
      gcc-14=14.2.0-19 \
      musl=1.2.5-3.1~deb13u1 \
      musl-dev=1.2.5-3.1~deb13u1 \
      musl-tools=1.2.5-3.1~deb13u1 && \
    rm -rf /var/lib/apt/lists/*

FROM builder-base AS builder-native

# cross-rs source revision: 55f847251389c5406df85579191c0eac412fab3a
# Copy only the compiler and sysroot; do not inherit emulator helpers or Cargo runners.
FROM --platform=linux/amd64 ${RISCV64_TOOLCHAIN_IMAGE} AS riscv64-toolchain

FROM builder-base AS builder-riscv64

ARG BUILDARCH

RUN apt-get -o Acquire::Check-Valid-Until=false update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      clang=1:19.0-63 \
      cmake=3.31.6-2 \
      libclang-dev=1:19.0-63 \
      ninja-build=1.12.1-1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=riscv64-toolchain /x-tools /x-tools
COPY source/ops/riscv64-musl-toolchain.cmake /opt/filebelt/riscv64-musl-toolchain.cmake
ENV PATH="/x-tools/riscv64-unknown-linux-musl/bin:${PATH}" \
    AR_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-ar" \
    AWS_LC_SYS_USE_SYSTEM_riscv64gc_unknown_linux_musl="0" \
    BINDGEN_EXTRA_CLANG_ARGS_riscv64gc_unknown_linux_musl="--sysroot=/x-tools/riscv64-unknown-linux-musl/riscv64-unknown-linux-musl/sysroot/" \
    CC_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-gcc" \
    CXX_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-g++" \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER="riscv64-unknown-linux-musl-gcc" \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-Ctarget-feature=+crt-static" \
    CMAKE_GENERATOR_riscv64gc_unknown_linux_musl="Ninja" \
    CMAKE_TOOLCHAIN_FILE_riscv64gc_unknown_linux_musl="/opt/filebelt/riscv64-musl-toolchain.cmake"

RUN if [ "${BUILDARCH}" != amd64 ]; then \
      echo "the pinned RISC-V cross compiler requires BUILDARCH=amd64" >&2; \
      exit 1; \
    fi && \
    compiler=/x-tools/riscv64-unknown-linux-musl/bin/riscv64-unknown-linux-musl-gcc && \
    linker=/x-tools/riscv64-unknown-linux-musl/bin/riscv64-unknown-linux-musl-ld && \
    test "$("${compiler}" -dumpfullversion)" = "14.3.0" && \
    test "$("${compiler}" -dumpmachine)" = "riscv64-unknown-linux-musl" && \
    test "$("${linker}" --version | sed -n '1p')" = "GNU ld (crosstool-NG UNKNOWN) 2.45" && \
    test "$(sha256sum "${compiler}" | awk '{print $1}')" = \
      "3fe20d705129f8ba4ae6be393fd4c484479f688f576af78c0ff2bb10e59d5f86"

FROM ${FILEBELT_BUILDER_STAGE} AS role-dependencies

ARG TARGETARCH

WORKDIR /repo
COPY . .

RUN case "${TARGETARCH}" in \
      amd64) target=x86_64-unknown-linux-musl ;; \
      arm64) target=aarch64-unknown-linux-musl ;; \
      riscv64) target=riscv64gc-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    rustup target add "${target}" && \
    host_target="$(rustc -vV | sed -n 's/^host: //p')" && \
    test -n "${host_target}" && \
    CARGO_NET_RETRY=10 cargo fetch --locked --target "${host_target}" --target "${target}"

FROM role-dependencies AS role-builder

ARG BUILDARCH
ARG TARGETARCH
ARG FILEBELT_ROLE
ARG FILEBELT_BUILDER_STAGE
ARG FILEBELT_TARGET_CPU=architecture-default
ARG FILEBELT_BUILD_VERSION=0.1.0-build.000000000000
ARG FILEBELT_BUILD_REVISION=unknown
ARG FILEBELT_BUILD_SOURCE_REF=unknown
ARG FILEBELT_BUILD_DIRTY=true
ARG FILEBELT_BUILD_KIND=local

ENV FILEBELT_BUILD_VERSION=${FILEBELT_BUILD_VERSION} \
    FILEBELT_BUILD_REVISION=${FILEBELT_BUILD_REVISION} \
    FILEBELT_BUILD_SOURCE_REF=${FILEBELT_BUILD_SOURCE_REF} \
    FILEBELT_BUILD_DIRTY=${FILEBELT_BUILD_DIRTY} \
    FILEBELT_BUILD_KIND=${FILEBELT_BUILD_KIND}

RUN case "${TARGETARCH}" in \
      amd64) target=x86_64-unknown-linux-musl ;; \
      arm64) target=aarch64-unknown-linux-musl ;; \
      riscv64) target=riscv64gc-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    if [ "${TARGETARCH}" = riscv64 ]; then \
      test "${BUILDARCH}" = amd64; \
      test "${FILEBELT_BUILDER_STAGE}" = builder-riscv64; \
    else \
      test "${TARGETARCH}" = "${BUILDARCH}"; \
      test "${FILEBELT_BUILDER_STAGE}" = builder-native; \
    fi && \
    if [ "${TARGETARCH}" = amd64 ]; then \
      test "${FILEBELT_TARGET_CPU}" = x86-64-v3; \
      export RUSTFLAGS="-Ctarget-cpu=${FILEBELT_TARGET_CPU} -Clink-arg=-Wl,-z,${FILEBELT_TARGET_CPU}"; \
      export CFLAGS="-march=${FILEBELT_TARGET_CPU}"; \
      export CXXFLAGS="${CFLAGS}"; \
    else \
      test "${FILEBELT_TARGET_CPU}" = architecture-default; \
    fi && \
    case "${FILEBELT_ROLE}" in \
      filebelt-api) package=filebelt-api; binary=filebelt-api ;; \
      filebelt-worker-io) package=filebelt-worker-io; binary=filebelt-worker-io ;; \
      filebelt-worker-maintenance) package=filebelt-worker-maintenance; binary=filebelt-worker-maintenance ;; \
      filebelt-media-controller) package=filebelt-media-controller; binary=filebelt-media-controller ;; \
      filebelt-document) package=filebelt-document; binary=filebelt-document ;; \
      filebelt-revision) package=filebelt-revision; binary=filebelt-revision ;; \
      filebelt-collaboration) package=filebelt-collaboration; binary=filebelt-collaboration ;; \
      filebelt-mcp-broker) package=filebelt-mcp-broker; binary=filebelt-mcp-broker ;; \
      filebelt-controller) package=filebelt-controller; binary=filebelt-controller ;; \
      filebelt-mcp-runner) package=filebelt-mcp-runner; binary=filebelt-mcp-runner ;; \
      filebelt-vfs) package=filebelt-vfs; binary=filebelt-vfs ;; \
      filebelt-headscale-sync) package=filebelt-headscale-sync; binary=filebelt-headscale-sync ;; \
      filebelt-nfs-relay) package=filebelt-nfs-relay; binary=filebelt-nfs-relay ;; \
      filebelt-private-egress-gateway) package=filebelt-private-egress-gateway; binary=filebelt-private-egress-gateway ;; \
      filebelt-tunnel-relay) package=filebelt-tunnel-relay; binary=filebelt-tunnel-relay ;; \
      filebelt-tools) package=filebeltctl; binary=filebeltctl ;; \
      *) echo "unsupported Rust FILEBELT_ROLE=${FILEBELT_ROLE}" >&2; exit 1 ;; \
    esac && \
    cargo build --locked --offline --release --package "${package}" --bin "${binary}" --target "${target}" && \
    install -D -m 0755 "target/${target}/release/${binary}" /out/filebelt && \
    sh source/ops/verify-static-elf.sh /out/filebelt "${target}" && \
    rust_notice=$(find /usr/local/rustup/toolchains -path '*/share/doc/rust/COPYRIGHT-library.html' -type f) && \
    test "$(printf '%s\n' "${rust_notice}" | wc -l)" -eq 1 && \
    install -D -m 0644 "${rust_notice}" /out/notices/Rust-COPYRIGHT-library.html

FROM role-builder AS runtime-rootfs

RUN install -d -m 0755 \
      /out/rootfs/etc \
      /out/rootfs/usr \
      /out/rootfs/usr/local \
      /out/rootfs/usr/local/bin \
      /out/rootfs/usr/share \
      /out/rootfs/usr/share/licenses \
      /out/rootfs/usr/share/licenses/FileBelt \
      /out/rootfs/usr/share/licenses/FileBelt/LICENSES \
      /out/rootfs/usr/share/licenses/FileBelt/notices && \
    install -m 0644 source/ops/runtime/passwd /out/rootfs/etc/passwd && \
    install -m 0644 source/ops/runtime/group /out/rootfs/etc/group && \
    install -m 0644 LICENSE /out/rootfs/usr/share/licenses/FileBelt/LICENSE && \
    install -m 0644 LICENSES/Apache-2.0.txt \
      /out/rootfs/usr/share/licenses/FileBelt/LICENSES/Apache-2.0.txt && \
    install -m 0644 LICENSES/MIT.txt \
      /out/rootfs/usr/share/licenses/FileBelt/LICENSES/MIT.txt && \
    install -m 0644 THIRD_PARTY_NOTICES.md \
      /out/rootfs/usr/share/licenses/FileBelt/THIRD_PARTY_NOTICES.md && \
    install -m 0644 /out/notices/Rust-COPYRIGHT-library.html \
      /out/rootfs/usr/share/licenses/FileBelt/notices/Rust-COPYRIGHT-library.html && \
    install -m 0644 source/ops/runtime/musl-COPYRIGHT \
      /out/rootfs/usr/share/licenses/FileBelt/notices/musl-COPYRIGHT && \
    case "${FILEBELT_ROLE}" in \
      filebelt-api|filebelt-worker-io|filebelt-worker-maintenance|filebelt-document|filebelt-revision|filebelt-collaboration|filebelt-mcp-broker|filebelt-controller|filebelt-vfs|filebelt-headscale-sync|filebelt-nfs-relay|filebelt-private-egress-gateway|filebelt-tunnel-relay|filebelt-tools) \
        webpki_license=$(find /usr/local/cargo/registry/src -path '*/webpki-roots-1.0.9/LICENSE' -type f); \
        test "$(printf '%s\n' "${webpki_license}" | wc -l)" -eq 1; \
        install -m 0644 "${webpki_license}" \
          /out/rootfs/usr/share/licenses/FileBelt/LICENSES/CDLA-Permissive-2.0.txt; \
        install -m 0644 source/ops/runtime/webpki-roots-SOURCE.txt \
          /out/rootfs/usr/share/licenses/FileBelt/notices/webpki-roots-SOURCE.txt ;; \
    esac && \
    case "${FILEBELT_ROLE}" in \
      filebelt-worker-maintenance|filebelt-tools) \
        option_ext_license=$(find /usr/local/cargo/registry/src -path '*/option-ext-0.2.0/LICENSE.txt' -type f); \
        test "$(printf '%s\n' "${option_ext_license}" | wc -l)" -eq 1; \
        install -m 0644 "${option_ext_license}" \
          /out/rootfs/usr/share/licenses/FileBelt/LICENSES/MPL-2.0.txt; \
        install -m 0644 source/ops/runtime/option-ext-SOURCE.txt \
          /out/rootfs/usr/share/licenses/FileBelt/notices/option-ext-SOURCE.txt ;; \
    esac

FROM scratch AS runtime-files

ARG FILEBELT_TARGET_CPU
LABEL io.filebelt.build.target-cpu="${FILEBELT_TARGET_CPU}"

COPY --from=runtime-rootfs /out/rootfs/ /

FROM runtime-files AS filebelt-api
ARG FILEBELT_BUILD_VERSION
ARG FILEBELT_BUILD_REVISION
ARG FILEBELT_BUILD_SOURCE_REF
ARG FILEBELT_BUILD_DIRTY
ARG FILEBELT_BUILD_KIND
ARG FILEBELT_CREATED
COPY --from=role-builder --chmod=0755 /out/filebelt /usr/local/bin/filebelt-api
LABEL org.opencontainers.image.title="filebelt-api" \
      org.opencontainers.image.description="FileBelt API service" \
      org.opencontainers.image.source="https://github.com/OxiBelt/FileBelt" \
      org.opencontainers.image.url="https://github.com/OxiBelt/FileBelt" \
      org.opencontainers.image.version="${FILEBELT_BUILD_VERSION}" \
      org.opencontainers.image.revision="${FILEBELT_BUILD_REVISION}" \
      org.opencontainers.image.created="${FILEBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT AND CDLA-Permissive-2.0" \
      io.filebelt.image.role="filebelt-api" \
      io.filebelt.build.source-ref="${FILEBELT_BUILD_SOURCE_REF}" \
      io.filebelt.build.dirty="${FILEBELT_BUILD_DIRTY}" \
      io.filebelt.build.kind="${FILEBELT_BUILD_KIND}"
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/filebelt-api"]

FROM runtime-files AS filebelt-worker-io
ARG FILEBELT_BUILD_VERSION
ARG FILEBELT_BUILD_REVISION
ARG FILEBELT_BUILD_SOURCE_REF
ARG FILEBELT_BUILD_DIRTY
ARG FILEBELT_BUILD_KIND
ARG FILEBELT_CREATED
COPY --from=role-builder --chmod=0755 /out/filebelt /usr/local/bin/filebelt-worker-io
LABEL org.opencontainers.image.title="filebelt-worker-io" \
      org.opencontainers.image.description="FileBelt I/O worker" \
      org.opencontainers.image.source="https://github.com/OxiBelt/FileBelt" \
      org.opencontainers.image.url="https://github.com/OxiBelt/FileBelt" \
      org.opencontainers.image.version="${FILEBELT_BUILD_VERSION}" \
      org.opencontainers.image.revision="${FILEBELT_BUILD_REVISION}" \
      org.opencontainers.image.created="${FILEBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT AND CDLA-Permissive-2.0" \
      io.filebelt.image.role="filebelt-worker-io" \
      io.filebelt.build.source-ref="${FILEBELT_BUILD_SOURCE_REF}" \
      io.filebelt.build.dirty="${FILEBELT_BUILD_DIRTY}" \
      io.filebelt.build.kind="${FILEBELT_BUILD_KIND}"
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/filebelt-worker-io"]

