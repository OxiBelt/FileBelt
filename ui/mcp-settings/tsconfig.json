{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "source",
    "skipLibCheck": true,
    "tsBuildInfoFile": "dist/mcp-settings.tsbuildinfo"
  },
  "include": ["source/**/*.ts", "source/**/*.tsx"],
  "exclude": ["source/**/*.test.ts", "source/**/*.test.tsx"]
}
