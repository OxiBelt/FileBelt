{
  "name": "@filebelt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm --filter @filebelt/markdown build && vite --host 127.0.0.1",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test --tsconfig playwright.tsconfig.json",
    "test:browser:docker": "playwright test --config playwright.docker.config.mjs --tsconfig playwright.tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@filebelt/admin": "workspace:*",
    "@filebelt/design-system": "workspace:*",
    "@filebelt/markdown": "workspace:*",
    "@filebelt/mcp-settings": "workspace:*",
    "@fluentui/react-components": "9.74.10",
    "lucide-react": "1.59.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
